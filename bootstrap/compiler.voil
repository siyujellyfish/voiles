import host

fn main()->int{
    return imports() + declarations() + host.finish_names()
}

fn imports()->int{
    if (host.at("import") != 0) {
        return host.expect("import") + host.module_import() + imports()
    } else {
        return 0
    }
}

fn declarations()->int{
    if (host.at_end() != 0) {
        return 0
    } else {
        return declaration() + declarations()
    }
}

fn declaration()->int{
    if (host.at("struct") != 0) {
        return structure()
    } else {
        return host.expect("fn") + host.emit("fn ") + host.function() + signature() + body() + host.finish_function() + host.emit("}\n")
    }
}

fn structure()->int{
    return host.expect("struct") + host.emit("#[derive(Clone,Copy)]\nstruct ") + host.structure() + host.expect("{") + host.emit("{\n") + fields() + host.expect("}") + host.finish_structure() + host.emit("}\n")
}

fn fields()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return host.expect("var") + host.field() + host.expect(":") + host.expect("int") + host.expect("=") + host.field_default() + host.emit(",\n") + fields()
    }
}

fn signature()->int{
    return host.expect("(") + host.emit("(s: &mut Machine, depth: usize") + parameters() + host.expect(")") + host.expect("->") + host.expect("int") + host.emit(") -> R {\ns.enter(depth)?;\n")
}

fn parameters()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.emit(", ") + host.parameter() + host.expect(":") + parameter_type() + following_parameters()
    }
}

fn following_parameters()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.emit(", ") + host.parameter() + host.expect(":") + parameter_type() + following_parameters()
    } else {
        return 0
    }
}

fn parameter_type()->int{
    if (host.at("str") != 0) {
        return host.expect("str") + host.emit(": String")
    } else {
        return host.expect("int") + host.emit(": i64")
    }
}

fn body()->int{
    return host.expect("{") + statement() + host.expect("}")
}

fn statement()->int{
    if (host.at_str_local() != 0) {
        return host.str_local() + statement()
    } else {
        if (host.at("var") != 0) {
            return local() + statement()
        } else {
            if (host.at_str_assignment() != 0) {
                return host.str_assignment() + statement()
            } else {
                if (host.at_field_write() != 0) {
                    return host.field_target() + host.expect("=") + expression() + host.emit(";\n") + statement()
                } else {
                    if (host.at("with") != 0) {
                        if (host.at_dict_borrow() != 0) {
                            return dict_borrow()
                        } else {
                            return list_borrow()
                        }
                    } else {
                        if (host.at("try") != 0) {
                            return try_statement()
                        } else {
                            if (host.at("match") != 0) {
                                return match_statement()
                            } else {
                                if (host.at("return") != 0) {
                                    return host.expect("return") + host.return_start() + expression() + host.emit(")\n")
                                } else {
                                    return control()
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn try_statement()->int{
    return host.expect("try") + host.try_start() + host.expect("{") + statement() + host.expect("}") + host.try_handler() + host.expect("except") + host.exception_category() + exception_binding() + host.expect("{") + statement() + host.expect("}") + host.finish_try() + after_try()
}

fn exception_binding()->int{
    if (host.at("as") != 0) {
        return host.expect("as") + host.exception_binding()
    } else {
        return 0
    }
}

fn after_try()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return statement()
    }
}

fn match_statement()->int{
    return host.expect("match") + host.match_start() + host.expect("(") + match_subject() + host.expect(")") + host.emit(" {\n") + host.expect("{") + match_arms() + host.expect("}") + host.finish_match() + after_match()
}

fn match_subject()->int{
    if (host.at("true") != 0) {
        return host.match_boolean_subject()
    } else {
        if (host.at("false") != 0) {
            return host.match_boolean_subject()
        } else {
            return host.match_integer_subject() + expression()
        }
    }
}

fn match_arms()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return host.expect("case") + match_pattern() + host.expect("{") + statement() + host.expect("}") + host.finish_match_arm() + match_arms()
    }
}

fn match_pattern()->int{
    if (host.at("_") != 0) {
        return host.match_wildcard()
    } else {
        return host.match_pattern()
    }
}

fn after_match()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return statement()
    }
}

fn list_borrow()->int{
    return host.expect("with") + host.list_owner() + host.expect("[") + expression() + host.expect("]") + host.expect("as") + host.list_alias() + host.expect("{") + statement() + host.expect("}") + host.finish_list_borrow() + after_list_borrow()
}

fn dict_borrow()->int{
    return host.expect("with") + host.dict_owner() + host.expect("[") + host.dict_selector() + host.expect("]") + host.expect("as") + host.dict_alias() + host.expect("{") + statement() + host.expect("}") + host.finish_dict_borrow() + after_list_borrow()
}

fn after_list_borrow()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return statement()
    }
}

fn local()->int{
    if (host.at_nested_dict_local() != 0) {
        return nested_dict_local()
    } else {
        if (host.at_nested_list_local() != 0) {
            return nested_list_local()
        } else {
            if (host.at_list_local() != 0) {
                return list_local()
            } else {
                if (host.at_dict_local() != 0) {
                    return dict_local()
                } else {
                    return struct_local()
                }
            }
        }
    }
}

fn struct_local()->int{
    return host.expect("var") + host.local() + host.expect(":") + host.local_type() + host.expect("=") + host.constructor() + host.expect("(") + constructor_arguments() + host.expect(")") + host.finish_constructor() + host.emit(";\n")
}

fn list_local()->int{
    return host.expect("var") + host.list_local() + host.expect(":") + host.expect("list") + host.expect("[") + host.expect("int") + host.expect("]") + host.expect("=") + host.expect("[") + list_items() + host.expect("]") + host.finish_list() + host.emit(";\n")
}

fn list_items()->int{
    if (host.at("]") != 0) {
        return 0
    } else {
        return host.list_item() + expression() + following_list_items()
    }
}

fn following_list_items()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.list_item() + expression() + following_list_items()
    } else {
        return 0
    }
}

fn nested_list_local()->int{
    return host.expect("var") + host.nested_list_local() + host.expect(":") + host.expect("list") + host.expect("[") + host.expect("list") + host.expect("[") + host.expect("int") + host.expect("]") + host.expect("]") + host.expect("=") + host.expect("[") + nested_rows() + host.expect("]") + host.finish_nested_list() + host.emit(";\n")
}

fn nested_rows()->int{
    if (host.at("]") != 0) {
        return 0
    } else {
        return host.nested_row() + host.expect("[") + nested_items() + host.expect("]") + host.finish_nested_row() + following_nested_rows()
    }
}

fn following_nested_rows()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.nested_row() + host.expect("[") + nested_items() + host.expect("]") + host.finish_nested_row() + following_nested_rows()
    } else {
        return 0
    }
}

fn nested_items()->int{
    if (host.at("]") != 0) {
        return 0
    } else {
        return host.nested_item() + expression() + following_nested_items()
    }
}

fn following_nested_items()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.nested_item() + expression() + following_nested_items()
    } else {
        return 0
    }
}

fn dict_local()->int{
    return host.expect("var") + host.dict_local() + host.expect(":") + host.expect("dict") + host.expect("{") + host.expect("str") + host.expect(",") + host.expect("int") + host.expect("}") + host.expect("=") + host.expect("{") + dict_items() + host.expect("}") + host.finish_dict() + host.emit(";\n")
}

fn dict_items()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return host.dict_key() + expression() + host.emit(")") + following_dict_items()
    }
}

fn following_dict_items()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.dict_key() + expression() + host.emit(")") + following_dict_items()
    } else {
        return 0
    }
}

fn nested_dict_local()->int{
    return host.expect("var") + host.nested_dict_local() + host.expect(":") + host.expect("dict") + host.expect("{") + host.expect("str") + host.expect(",") + host.expect("list") + host.expect("[") + host.expect("int") + host.expect("]") + host.expect("}") + host.expect("=") + host.expect("{") + nested_dict_items() + host.expect("}") + host.finish_nested_dict() + host.emit(";\n")
}

fn nested_dict_items()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return host.nested_dict_key() + host.expect("[") + nested_items() + host.expect("]") + host.finish_nested_dict_value() + following_nested_dict_items()
    }
}

fn following_nested_dict_items()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.nested_dict_key() + host.expect("[") + nested_items() + host.expect("]") + host.finish_nested_dict_value() + following_nested_dict_items()
    } else {
        return 0
    }
}

fn constructor_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.constructor_field() + host.expect("=") + expression() + following_constructor_arguments()
    }
}

fn following_constructor_arguments()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + constructor_tail()
    } else {
        return 0
    }
}

fn constructor_tail()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.constructor_field() + host.expect("=") + expression() + following_constructor_arguments()
    }
}

fn control()->int{
    if (host.at("while") != 0) {
        return host.expect("while") + host.emit("while ") + comparison() + host.expect("{") + host.emit("s.enter(depth)?;\n") + actions() + host.expect("}") + host.emit("}\n") + statement()
    } else {
        if (host.if_has_continuation() != 0) {
            return condition() + host.if_scope_start() + host.expect("{") + if_flow_body() + host.expect("}") + host.expect("else") + host.if_scope_else() + host.emit("} else {\n") + host.expect("{") + if_flow_body() + host.expect("}") + host.if_scope_finish() + host.emit("}\n") + statement()
        } else {
            return condition() + host.if_scope_start() + body() + host.expect("else") + host.if_scope_else() + host.emit("} else {\n") + body() + host.if_scope_finish() + host.emit("}\n")
        }
    }
}

fn if_flow_body()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        if (host.at_str_local() != 0) {
            return host.str_local() + if_flow_body()
        } else {
            return host.str_assignment() + if_flow_body()
        }
    }
}

fn condition()->int{
    return host.expect("if") + host.emit("if ") + comparison()
}

fn actions()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return call() + host.emit(";\n") + actions()
    }
}

fn comparison()->int{
    return host.expect("(") + expression() + relation() + expression() + host.expect(")") + host.emit(" {\n")
}

fn relation()->int{
    if (host.at("!=") != 0) {
        return host.expect("!=") + host.emit(" != ")
    } else {
        return equality()
    }
}

fn equality()->int{
    if (host.at("==") != 0) {
        return host.expect("==") + host.emit(" == ")
    } else {
        return ordering()
    }
}

fn ordering()->int{
    if (host.at("<=") != 0) {
        return host.expect("<=") + host.emit(" <= ")
    } else {
        return upper()
    }
}

fn upper()->int{
    if (host.at(">=") != 0) {
        return host.expect(">=") + host.emit(" >= ")
    } else {
        return strict()
    }
}

fn strict()->int{
    if (host.at("<") != 0) {
        return host.expect("<") + host.emit(" < ")
    } else {
        return host.expect(">") + host.emit(" > ")
    }
}

fn expression()->int{
    return product() + additions()
}

fn additions()->int{
    if (host.at("+") != 0) {
        return host.expect("+") + host.emit(".checked_add(") + product() + host.emit(").ok_or(Fault::Overflow)?") + additions()
    } else {
        return subtractions()
    }
}

fn subtractions()->int{
    if (host.at("-") != 0) {
        return host.expect("-") + host.emit(".checked_sub(") + product() + host.emit(").ok_or(Fault::Overflow)?") + additions()
    } else {
        return 0
    }
}

fn product()->int{
    return primary() + factors()
}

fn factors()->int{
    if (host.at("*") != 0) {
        return host.expect("*") + host.emit(".checked_mul(") + primary() + host.emit(").ok_or(Fault::Overflow)?") + factors()
    } else {
        return divisions()
    }
}

fn divisions()->int{
    if (host.at("/") != 0) {
        return host.expect("/") + host.emit(".checked_div(") + primary() + host.emit(").ok_or(Fault::Overflow)?") + factors()
    } else {
        return 0
    }
}

fn primary()->int{
    if (host.at("(") != 0) {
        return host.expect("(") + host.emit("(") + expression() + host.expect(")") + host.emit(")")
    } else {
        return atom()
    }
}

fn atom()->int{
    if (host.at_conversion() != 0) {
        return host.conversion()
    } else {
        if (host.at_integer() != 0) {
            return host.literal()
        } else {
            if (host.at("host") != 0) {
                return call()
            } else {
                if (host.at_len() != 0) {
                    return host.list_len()
                } else {
                    if (host.at_dict_set() != 0) {
                        return host.dict_set() + host.dict_set_key() + host.expect(",") + expression() + host.expect(")") + host.finish_dict_set()
                    } else {
                        if (host.at_list_append() != 0) {
                            return host.list_append() + expression() + host.expect(")") + host.finish_list_append()
                        } else {
                            if (host.at_list_pop() != 0) {
                                return host.list_pop()
                            } else {
                                if (host.at_module_call() != 0) {
                                    return call()
                                } else {
                                    if (host.at_call() != 0) {
                                        return call()
                                    } else {
                                        if (host.at_field() != 0) {
                                            return host.field_value()
                                        } else {
                                            return host.value()
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn call()->int{
    if (host.at("host") != 0) {
        return host.expect("host") + host.expect(".") + host.method() + host.expect("(") + host.emit("(") + host_arguments() + host.expect(")") + host.emit(")?")
    } else {
        if (host.at_module_call() != 0) {
            return host.module_call() + host.expect("(") + host.emit("(s, depth + 1") + call_arguments() + host.expect(")") + host.finish_call() + host.emit(")?")
        } else {
            return host.call() + host.expect("(") + host.emit("(s, depth + 1") + call_arguments() + host.expect(")") + host.finish_call() + host.emit(")?")
        }
    }
}

fn host_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.literal()
    }
}

fn call_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        if (host.at_str_move_argument() != 0) {
            return host.str_move_argument() + following_arguments()
        } else {
            return host.argument() + host.emit(", ") + expression() + following_arguments()
        }
    }
}

fn following_arguments()->int{
    if (host.at(",") != 0) {
        if (host.at_str_move_argument() != 0) {
            return host.expect(",") + host.str_move_argument() + following_arguments()
        } else {
            return host.expect(",") + host.argument() + host.emit(", ") + expression() + following_arguments()
        }
    } else {
        return 0
    }
}
