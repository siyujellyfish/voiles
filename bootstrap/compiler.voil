import host

fn main()->int{
    return host.expect("import") + host.expect("host") + declarations()
}

fn declarations()->int{
    if (host.at_end() != 0) {
        return 0
    } else {
        return declaration() + declarations()
    }
}

fn declaration()->int{
    return host.expect("fn") + host.emit("fn ") + host.name() + signature() + body() + host.emit("}\n")
}

fn signature()->int{
    return host.expect("(") + host.emit("(s: &mut Machine, depth: usize") + parameters() + host.expect(")") + host.expect("->") + host.expect("int") + host.emit(") -> R {\ns.enter(depth)?;\n")
}

fn parameters()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.emit(", ") + host.name() + host.expect(":") + host.expect("int") + host.emit(": i64") + following_parameters()
    }
}

fn following_parameters()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + parameters()
    } else {
        return 0
    }
}

fn body()->int{
    return host.expect("{") + statement() + host.expect("}")
}

fn statement()->int{
    if (host.at("return") != 0) {
        return host.expect("return") + host.emit("Ok(") + expression() + host.emit(")\n")
    } else {
        return control()
    }
}

fn control()->int{
    if (host.at("while") != 0) {
        return host.expect("while") + host.emit("while ") + comparison() + host.expect("{") + host.emit("s.enter(depth)?;\n") + actions() + host.expect("}") + host.emit("}\n") + statement()
    } else {
        return condition() + body() + host.expect("else") + host.emit("} else {\n") + body() + host.emit("}\n")
    }
}

fn condition()->int{
    return host.expect("if") + host.emit("if ") + comparison()
}

fn actions()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return call() + host.emit(";\n") + actions()
    }
}

fn comparison()->int{
    return host.expect("(") + expression() + relation() + expression() + host.expect(")") + host.emit(" {\n")
}

fn relation()->int{
    if (host.at("!=") != 0) {
        return host.expect("!=") + host.emit(" != ")
    } else {
        return equality()
    }
}

fn equality()->int{
    if (host.at("==") != 0) {
        return host.expect("==") + host.emit(" == ")
    } else {
        return ordering()
    }
}

fn ordering()->int{
    if (host.at("<=") != 0) {
        return host.expect("<=") + host.emit(" <= ")
    } else {
        return upper()
    }
}

fn upper()->int{
    if (host.at(">=") != 0) {
        return host.expect(">=") + host.emit(" >= ")
    } else {
        return strict()
    }
}

fn strict()->int{
    if (host.at("<") != 0) {
        return host.expect("<") + host.emit(" < ")
    } else {
        return host.expect(">") + host.emit(" > ")
    }
}

fn expression()->int{
    return product() + additions()
}

fn additions()->int{
    if (host.at("+") != 0) {
        return host.expect("+") + host.emit(".checked_add(") + product() + host.emit(").ok_or(Fault::Overflow)?") + additions()
    } else {
        return subtractions()
    }
}

fn subtractions()->int{
    if (host.at("-") != 0) {
        return host.expect("-") + host.emit(".checked_sub(") + product() + host.emit(").ok_or(Fault::Overflow)?") + additions()
    } else {
        return 0
    }
}

fn product()->int{
    return primary() + factors()
}

fn factors()->int{
    if (host.at("*") != 0) {
        return host.expect("*") + host.emit(".checked_mul(") + primary() + host.emit(").ok_or(Fault::Overflow)?") + factors()
    } else {
        return divisions()
    }
}

fn divisions()->int{
    if (host.at("/") != 0) {
        return host.expect("/") + host.emit(".checked_div(") + primary() + host.emit(").ok_or(Fault::Overflow)?") + factors()
    } else {
        return 0
    }
}

fn primary()->int{
    if (host.at("(") != 0) {
        return host.expect("(") + host.emit("(") + expression() + host.expect(")") + host.emit(")")
    } else {
        return atom()
    }
}

fn atom()->int{
    if (host.at_integer() != 0) {
        return host.literal()
    } else {
        if (host.at("host") != 0) {
            return call()
        } else {
            if (host.at_call() != 0) {
                return call()
            } else {
                return host.name()
            }
        }
    }
}

fn call()->int{
    if (host.at("host") != 0) {
        return host.expect("host") + host.expect(".") + host.method() + host.expect("(") + host.emit("(") + host_arguments() + host.expect(")") + host.emit(")?")
    } else {
        return host.name() + host.expect("(") + host.emit("(s, depth + 1") + call_arguments() + host.expect(")") + host.emit(")?")
    }
}

fn host_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.literal()
    }
}

fn call_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.emit(", ") + expression() + following_arguments()
    }
}

fn following_arguments()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + call_arguments()
    } else {
        return 0
    }
}
