import host

fn main()->int{
    return imports() + declarations() + host.finish_names()
}

fn imports()->int{
    if (host.at("import") != 0) {
        return host.expect("import") + host.module_import() + imports()
    } else {
        return 0
    }
}

fn declarations()->int{
    if (host.at_end() != 0) {
        return 0
    } else {
        return declaration() + declarations()
    }
}

fn declaration()->int{
    if (host.at("struct") != 0) {
        return structure()
    } else {
        return host.expect("fn") + host.emit("fn ") + host.function() + signature() + body() + host.finish_function() + host.emit("}\n")
    }
}

fn structure()->int{
    return host.expect("struct") + host.emit("#[derive(Clone,Copy)]\nstruct ") + host.structure() + host.expect("{") + host.emit("{\n") + fields() + host.expect("}") + host.finish_structure() + host.emit("}\n")
}

fn fields()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return host.expect("var") + host.field() + host.expect(":") + host.expect("int") + host.expect("=") + host.field_default() + host.emit(",\n") + fields()
    }
}

fn signature()->int{
    return host.expect("(") + host.emit("(s: &mut Machine, depth: usize") + parameters() + host.expect(")") + host.expect("->") + host.expect("int") + host.emit(") -> R {\ns.enter(depth)?;\n")
}

fn parameters()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.emit(", ") + host.parameter() + host.expect(":") + host.expect("int") + host.emit(": i64") + following_parameters()
    }
}

fn following_parameters()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.emit(", ") + host.parameter() + host.expect(":") + host.expect("int") + host.emit(": i64") + following_parameters()
    } else {
        return 0
    }
}

fn body()->int{
    return host.expect("{") + statement() + host.expect("}")
}

fn statement()->int{
    if (host.at("var") != 0) {
        return local() + statement()
    } else {
        if (host.at_field_write() != 0) {
            return host.field_target() + host.expect("=") + expression() + host.emit(";\n") + statement()
        } else {
            if (host.at("with") != 0) {
                return list_borrow()
            } else {
                if (host.at("return") != 0) {
                    return host.expect("return") + host.return_start() + expression() + host.emit(")\n")
                } else {
                    return control()
                }
            }
        }
    }
}

fn list_borrow()->int{
    return host.expect("with") + host.list_owner() + host.expect("[") + expression() + host.expect("]") + host.expect("as") + host.list_alias() + host.expect("{") + statement() + host.expect("}") + host.finish_list_borrow() + after_list_borrow()
}

fn after_list_borrow()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return statement()
    }
}

fn local()->int{
    if (host.at_list_local() != 0) {
        return list_local()
    } else {
        return struct_local()
    }
}

fn struct_local()->int{
    return host.expect("var") + host.local() + host.expect(":") + host.local_type() + host.expect("=") + host.constructor() + host.expect("(") + constructor_arguments() + host.expect(")") + host.finish_constructor() + host.emit(";\n")
}

fn list_local()->int{
    return host.expect("var") + host.list_local() + host.expect(":") + host.expect("list") + host.expect("[") + host.expect("int") + host.expect("]") + host.expect("=") + host.expect("[") + list_items() + host.expect("]") + host.finish_list() + host.emit(";\n")
}

fn list_items()->int{
    if (host.at("]") != 0) {
        return 0
    } else {
        return host.list_item() + expression() + following_list_items()
    }
}

fn following_list_items()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.list_item() + expression() + following_list_items()
    } else {
        return 0
    }
}

fn constructor_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.constructor_field() + host.expect("=") + expression() + following_constructor_arguments()
    }
}

fn following_constructor_arguments()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + constructor_tail()
    } else {
        return 0
    }
}

fn constructor_tail()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.constructor_field() + host.expect("=") + expression() + following_constructor_arguments()
    }
}

fn control()->int{
    if (host.at("while") != 0) {
        return host.expect("while") + host.emit("while ") + comparison() + host.expect("{") + host.emit("s.enter(depth)?;\n") + actions() + host.expect("}") + host.emit("}\n") + statement()
    } else {
        return condition() + body() + host.expect("else") + host.emit("} else {\n") + body() + host.emit("}\n")
    }
}

fn condition()->int{
    return host.expect("if") + host.emit("if ") + comparison()
}

fn actions()->int{
    if (host.at("}") != 0) {
        return 0
    } else {
        return call() + host.emit(";\n") + actions()
    }
}

fn comparison()->int{
    return host.expect("(") + expression() + relation() + expression() + host.expect(")") + host.emit(" {\n")
}

fn relation()->int{
    if (host.at("!=") != 0) {
        return host.expect("!=") + host.emit(" != ")
    } else {
        return equality()
    }
}

fn equality()->int{
    if (host.at("==") != 0) {
        return host.expect("==") + host.emit(" == ")
    } else {
        return ordering()
    }
}

fn ordering()->int{
    if (host.at("<=") != 0) {
        return host.expect("<=") + host.emit(" <= ")
    } else {
        return upper()
    }
}

fn upper()->int{
    if (host.at(">=") != 0) {
        return host.expect(">=") + host.emit(" >= ")
    } else {
        return strict()
    }
}

fn strict()->int{
    if (host.at("<") != 0) {
        return host.expect("<") + host.emit(" < ")
    } else {
        return host.expect(">") + host.emit(" > ")
    }
}

fn expression()->int{
    return product() + additions()
}

fn additions()->int{
    if (host.at("+") != 0) {
        return host.expect("+") + host.emit(".checked_add(") + product() + host.emit(").ok_or(Fault::Overflow)?") + additions()
    } else {
        return subtractions()
    }
}

fn subtractions()->int{
    if (host.at("-") != 0) {
        return host.expect("-") + host.emit(".checked_sub(") + product() + host.emit(").ok_or(Fault::Overflow)?") + additions()
    } else {
        return 0
    }
}

fn product()->int{
    return primary() + factors()
}

fn factors()->int{
    if (host.at("*") != 0) {
        return host.expect("*") + host.emit(".checked_mul(") + primary() + host.emit(").ok_or(Fault::Overflow)?") + factors()
    } else {
        return divisions()
    }
}

fn divisions()->int{
    if (host.at("/") != 0) {
        return host.expect("/") + host.emit(".checked_div(") + primary() + host.emit(").ok_or(Fault::Overflow)?") + factors()
    } else {
        return 0
    }
}

fn primary()->int{
    if (host.at("(") != 0) {
        return host.expect("(") + host.emit("(") + expression() + host.expect(")") + host.emit(")")
    } else {
        return atom()
    }
}

fn atom()->int{
    if (host.at_integer() != 0) {
        return host.literal()
    } else {
        if (host.at("host") != 0) {
            return call()
        } else {
            if (host.at_len() != 0) {
                return host.list_len()
            } else {
                if (host.at_list_append() != 0) {
                    return host.list_append() + expression() + host.expect(")") + host.finish_list_append()
                } else {
                    if (host.at_list_pop() != 0) {
                        return host.list_pop()
                    } else {
                        if (host.at_module_call() != 0) {
                            return call()
                        } else {
                            if (host.at_call() != 0) {
                                return call()
                            } else {
                                if (host.at_field() != 0) {
                                    return host.field_value()
                                } else {
                                    return host.value()
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn call()->int{
    if (host.at("host") != 0) {
        return host.expect("host") + host.expect(".") + host.method() + host.expect("(") + host.emit("(") + host_arguments() + host.expect(")") + host.emit(")?")
    } else {
        if (host.at_module_call() != 0) {
            return host.module_call() + host.expect("(") + host.emit("(s, depth + 1") + call_arguments() + host.expect(")") + host.finish_call() + host.emit(")?")
        } else {
            return host.call() + host.expect("(") + host.emit("(s, depth + 1") + call_arguments() + host.expect(")") + host.finish_call() + host.emit(")?")
        }
    }
}

fn host_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.literal()
    }
}

fn call_arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.argument() + host.emit(", ") + expression() + following_arguments()
    }
}

fn following_arguments()->int{
    if (host.at(",") != 0) {
        return host.expect(",") + host.argument() + host.emit(", ") + expression() + following_arguments()
    } else {
        return 0
    }
}
