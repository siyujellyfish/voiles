import host

fn main()->int{
    return host.expect("import") + host.expect("host") + declarations()
}

fn declarations()->int{
    if (host.at_end() != 0) {
        return 0
    } else {
        return declaration() + declarations()
    }
}

fn declaration()->int{
    return host.expect("fn") + host.emit("fn ") + host.name() + signature() + body() + host.emit("}\n")
}

fn signature()->int{
    return host.expect("(") + host.expect(")") + host.expect("->") + host.expect("int") + host.emit("(s: &mut Machine, depth: usize) -> R {\ns.enter(depth)?;\n")
}

fn body()->int{
    return host.expect("{") + statement() + host.expect("}")
}

fn statement()->int{
    if (host.at("return") != 0) {
        return host.expect("return") + host.emit("Ok(") + expression() + host.emit(")\n")
    } else {
        return condition() + body() + host.expect("else") + host.emit("} else {\n") + body() + host.emit("}\n")
    }
}

fn condition()->int{
    return host.expect("if") + host.expect("(") + host.emit("if ") + expression() + host.expect("!") + host.expect("=") + host.emit(" != ") + expression() + host.expect(")") + host.emit(" {\n")
}

fn expression()->int{
    return atom() + additions()
}

fn additions()->int{
    if (host.at("+") != 0) {
        return host.expect("+") + host.emit(".checked_add(") + atom() + host.emit(").ok_or(Fault::Overflow)?") + additions()
    } else {
        return 0
    }
}

fn atom()->int{
    if (host.at_integer() != 0) {
        return host.literal()
    } else {
        return call()
    }
}

fn call()->int{
    if (host.at("host") != 0) {
        return host.expect("host") + host.expect(".") + host.method() + host.expect("(") + host.emit("(") + arguments() + host.expect(")") + host.emit(")?")
    } else {
        return host.name() + host.expect("(") + host.expect(")") + host.emit("(s, depth + 1)?")
    }
}

fn arguments()->int{
    if (host.at(")") != 0) {
        return 0
    } else {
        return host.literal()
    }
}
