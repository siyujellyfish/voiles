# 自舉子集以半開的原始位元組跨度保存詞值。
struct Token{
    var kind:int
    var start:int
    var end:int
}

fn letter(b:int)->bool{
    return b >= 65 and b <= 90 or b >= 97 and b <= 122 or b == 95
}

fn digit(b:int)->bool{
    return b >= 48 and b <= 57
}

# 小寫 a..z 編為 1..26，每字母占五位；最長關鍵字八字母。
fn keyword(key:int)->bool{
    match(key){
        case 206{ return true }  # fn
        case 3652212{ return true }  # const
        case 22578{ return true }  # var
        case 20186693{ return true }  # share
        case 294{ return true }  # if
        case 176741{ return true }  # else
        case 609900110{ return true }  # return
        case 674469{ return true }  # true
        case 6337125{ return true }  # false
        case 659117172{ return true }  # struct
        case 1697219{ return true }  # async
        case 24388997{ return true }  # while
        case 6642{ return true }  # for
        case 316161620{ return true }  # import
        case 1476{ return true }  # and
        case 498{ return true }  # or
        case 14836{ return true }  # not
        case 307{ return true }  # is
        case 474565{ return true }  # none
        case 2692139{ return true }  # break
        case 119676385957{ return true }  # continue
        case 21081{ return true }  # try
        case 193041940{ return true }  # except
        case _{ return false }
    }
}

fn scan(data:list[int])->list[Token]{
    var tokens:list[Token] = []
    const size:int = len(data)
    var i:int = 0
    var depth:int = 0
    while(i < size){
        const start:int = i
        var b:int = 0
        with data[i] as first{ b = first }
        i = i + 1
        var next:int = -1
        if(i < size){ with data[i] as look{ next = look } }
        var kind:int = 5
        if(b == 32 or b == 9){
            kind = 0
        } else if(b == 10 or b == 13){
            if(b == 13 and next == 10){ i = i + 1 }
            if(depth == 0){ kind = 7 } else { kind = 0 }
        } else if(letter(b)){
            var key:int = b - 96
            while(letter(next) or digit(next)){
                if(key > 0 and i - start < 8 and next >= 97 and next <= 122){
                    key = key * 32 + next - 96
                } else { key = 0 }
                i = i + 1
                next = -1
                if(i < size){ with data[i] as look{ next = look } }
            }
            if(keyword(key)){ kind = 1 } else { kind = 2 }
        } else if(digit(b)){
            kind = 3
            while(digit(next)){
                i = i + 1
                next = -1
                if(i < size){ with data[i] as look{ next = look } }
            }
        } else if(b == 34){
            kind = 4
            var closed:bool = false
            var escaped:bool = false
            while(i < size and not closed){
                var c:int = 0
                with data[i] as current{ c = current }
                if(c == 10 or c == 13){ closed = true
                    kind = 8
                } else {
                    i = i + 1
                    if(escaped){ escaped = false }
                    else if(c == 92){ escaped = true }
                    else if(c == 34){ closed = true }
                }
            }
            if(not closed){ kind = 8 }
        } else if(b == 45 and next == 62){
            i = i + 1
            kind = 6
        } else if(b == 40){
            depth = depth + 1
        } else if(b == 41 and depth > 0){
            depth = depth - 1
        } else if(b >= 128){
            # 有效 UTF-8 純量是一個符號；非法序列每次只前進一個位元組。
            var width:int = 0
            if(b >= 194 and b <= 223){ width = 2 }
            else if(b >= 224 and b <= 239){ width = 3 }
            else if(b >= 240 and b <= 244){ width = 4 }
            var valid:bool = width > 0 and start + width <= size
            var offset:int = 1
            while(valid and offset < width){
                const position:int = start + offset
                var c:int = 0
                with data[position] as current{ c = current }
                if(c < 128 or c > 191){ valid = false }
                if(offset == 1){
                    if(b == 224 and c < 160 or b == 237 and c >= 160){ valid = false }
                    if(b == 240 and c < 144 or b == 244 and c >= 144){ valid = false }
                }
                offset = offset + 1
            }
            if(valid){ i = start + width } else { kind = 8 }
        }
        if(kind != 0){ tokens.append(Token(kind=kind,start=start,end=i)) }
    }
    tokens.append(Token(kind=9,start=size,end=size))
    return tokens.move()
}
